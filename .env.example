# --- Core ---
DATABASE_URL=postgresql://invoice:invoice@localhost:5434/invoice
INBOX_DIR=./data/inbox
ARCHIVE_DIR=./data/archive
SAMPLE_DIR=./samples
METRICS_PORT=8001

# --- Extraction ---
# mock    = deterministic regex extractor, no network (default, used by the demo)
# openai  = OpenAI-compatible chat completions endpoint
# auto    = openai when LLM_API_KEY is set, otherwise mock
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
MIN_CONFIDENCE=0.55

# --- Notifications ---
# Slack incoming webhook. When empty, notifications are recorded as "mock"
# and shown in the UI feed.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# en or pt-BR
NOTIFY_LANGUAGE=en

# --- Worker ---
WORKER_POLL_SECONDS=2
WATCHER_POLL_SECONDS=3
INBOX_SETTLE_SECONDS=2
MAX_ATTEMPTS=3
STALE_PROCESSING_SECONDS=300

# --- Optional IMAP ingestion ---
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true
IMAP_POLL_SECONDS=60

# --- Demo ---
MAX_PDF_BYTES=15728640
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:8000
